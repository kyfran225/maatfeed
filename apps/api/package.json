{
  "name": "@maat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "tsx src/bootstrap/registerJobs.ts",
    "worker:prod": "node dist/bootstrap/registerJobs.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "seed:ranking": "tsx ../../infra/scripts/seed-ranking-config.ts",
    "readiness": "tsx ../../infra/scripts/run-readiness-check.ts",
    "delete:user": "tsx ../../infra/scripts/delete-user.ts",
    "sync:audio": "tsx ../../infra/scripts/sync-audio-sources.ts",
    "audit:classification": "tsx src/scripts/auditClassificationPipeline.ts",
    "test:multi-ai": "tsx src/scripts/testMultiPersonalityAI.ts",
    "validate:ai": "tsx src/scripts/validateLiveAI.ts"
  },
  "dependencies": {
    "@maat/shared": "0.1.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
